// ============================================
// SCHOOL MANAGEMENT SYSTEM - PRISMA SCHEMA
// ============================================
// Source of truth: backend/database-schema.sql
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// CORE TABLES
// ============================================

/// Schools (Core tenant table)
model School {
  schoolId   String    @id @default(dbgenerated("gen_random_uuid()")) @map("school_id") @db.Uuid
  schoolName String    @map("school_name") @db.VarChar
  address    String?   @db.Text
  city       String?   @db.VarChar
  state      String?   @db.VarChar
  phone      String?   @db.VarChar
  email      String?   @db.VarChar
  website    String?   @db.VarChar
  subdomain  String?   @db.VarChar
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime? @default(now()) @map("updated_at") @db.Timestamptz()

  // Relations
  admins               Admin[]
  teachers             Teacher[]
  parents              Parent[]
  classes              Class[]
  exams                Exam[]
  fees                 Fee[]
  feePredictions       FeePrediction[]
  libraryBooks         LibraryBook[]
  transport            Transport[]
  inventory            Inventory[]
  notifications        Notification[]
  smartNotifications   SmartNotification[]
  conversations        Conversation[]
  chatRequests         ChatRequest[]
  meetings             Meeting[]
  leaveRequests        LeaveRequest[]
  classAnnouncements   ClassAnnouncement[]
  activities           Activity[]
  allowedStudents      AllowedStudent[]
  whitelistedTeachers  WhitelistedTeacher[]
  whitelistedParents   WhitelistedParent[]
  aiChatbotConversations AiChatbotConversation[]
  adminAiInsights      AdminAiInsight[]
  teacherPerformanceMetrics TeacherPerformanceMetric[]
  users                User[]

  @@map("schools")
}

/// Super Admins (Platform-level administrators)
model SuperAdmin {
  superAdminId String    @id @default(dbgenerated("gen_random_uuid()")) @map("super_admin_id") @db.Uuid
  authUserId   String    @map("auth_user_id") @db.Uuid
  email        String    @db.VarChar
  fullName     String    @map("full_name") @db.VarChar
  status       String?   @default("active") @db.VarChar
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  @@map("super_admins")
}

/// Auth Refresh Tokens (For secure refresh token rotation + revocation)
model AuthRefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId  String    @map("auth_user_id") @db.Uuid
  tokenHash   String    @map("token_hash") @db.VarChar // SHA256 hash of the token
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz()
  replacedBy  String?   @map("replaced_by") @db.Uuid // Points to new token after rotation

  @@index([authUserId])
  @@index([tokenHash])
  @@map("auth_refresh_tokens")
}

/// Admins (School-level administrators)
model Admin {
  adminId      String    @id @default(dbgenerated("gen_random_uuid()")) @map("admin_id") @db.Uuid
  authUserId   String    @map("auth_user_id") @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  fullName     String    @map("full_name") @db.VarChar
  email        String    @db.VarChar
  phone        String?   @db.VarChar
  department   String?   @db.VarChar
  adminLevel   String?   @map("admin_level") @db.VarChar
  permissions  Json?     @default("[]") @db.JsonB
  status       String?   @default("active") @db.VarChar
  profileImage String?   @map("profile_image") @db.Text
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  school School @relation(fields: [schoolId], references: [schoolId])

  @@map("admins")
}

/// Teachers
model Teacher {
  teacherId             String    @id @default(dbgenerated("gen_random_uuid()")) @map("teacher_id") @db.Uuid
  authUserId            String    @map("auth_user_id") @db.Uuid
  schoolId              String    @map("school_id") @db.Uuid
  fullName              String    @map("full_name") @db.VarChar
  email                 String    @db.VarChar
  phone                 String?   @db.VarChar
  qualification         String?   @db.VarChar
  experience            Int?
  subjectSpecialization String?   @map("subject_specialization") @db.Text
  status                String?   @default("active") @db.VarChar
  profileImage          String?   @map("profile_image") @db.Text
  createdAt             DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  school                School                  @relation(fields: [schoolId], references: [schoolId])
  classTeacherOf        Class[]                 @relation("ClassTeacher")
  subjects              Subject[]
  timetable             Timetable[]
  attendance            Attendance[]
  assignments           Assignment[]
  payroll               Payroll[]
  aiLessonPlans         AiLessonPlan[]
  aiGeneratedAssignments AiGeneratedAssignment[]
  aiReportComments      AiReportComment[]
  aiAttendanceAnalysis  AiAttendanceAnalysis[]
  leaveRequestsReviewed LeaveRequest[]          @relation("ReviewedBy")
  classAnnouncements    ClassAnnouncement[]
  teacherPerformanceMetrics TeacherPerformanceMetric[]

  @@map("teachers")
}

/// Classes
model Class {
  classId        String    @id @default(dbgenerated("gen_random_uuid()")) @map("class_id") @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  className      String    @map("class_name") @db.VarChar
  section        String?   @db.VarChar
  classTeacherId String?   @map("class_teacher_id") @db.Uuid
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  school             School              @relation(fields: [schoolId], references: [schoolId])
  classTeacher       Teacher?            @relation("ClassTeacher", fields: [classTeacherId], references: [teacherId])
  students           Student[]
  subjects           Subject[]
  timetable          Timetable[]
  attendance         Attendance[]
  assignments        Assignment[]
  exams              Exam[]
  allowedStudents    AllowedStudent[]
  aiLessonPlans      AiLessonPlan[]
  aiGeneratedAssignments AiGeneratedAssignment[]
  aiAttendanceAnalysis AiAttendanceAnalysis[]
  leaveRequests      LeaveRequest[]
  classAnnouncements ClassAnnouncement[]

  @@map("classes")
}

/// Students
model Student {
  studentId                   String    @id @default(dbgenerated("gen_random_uuid()")) @map("student_id") @db.Uuid
  authUserId                  String    @map("auth_user_id") @db.Uuid
  classId                     String?   @map("class_id") @db.Uuid
  parentId                    String?   @map("parent_id") @db.Uuid
  fullName                    String    @map("full_name") @db.VarChar
  email                       String    @db.VarChar
  phone                       String?   @db.VarChar
  rollNo                      String?   @map("roll_no") @db.VarChar
  section                     String?   @db.VarChar
  admissionNumber             String?   @map("admission_number") @db.VarChar
  dob                         DateTime? @db.Date
  gender                      String?   @db.VarChar
  bloodGroup                  String?   @map("blood_group") @db.VarChar
  nationality                 String?   @default("Indian") @db.VarChar
  motherTongue                String?   @map("mother_tongue") @db.VarChar
  religion                    String?   @db.VarChar
  admissionDate               DateTime? @map("admission_date") @db.Date
  dateOfAdmission             DateTime? @map("date_of_admission") @db.Date
  academicYear                String?   @map("academic_year") @db.VarChar
  previousSchool              String?   @map("previous_school") @db.VarChar
  mediumOfInstruction         String?   @map("medium_of_instruction") @db.VarChar
  studentCategory             String?   @map("student_category") @db.VarChar
  district                    String?   @db.VarChar
  doorNo                      String?   @map("door_no") @db.VarChar
  street                      String?   @db.VarChar
  villageTown                 String?   @map("village_town") @db.VarChar
  studentPhone                String?   @map("student_phone") @db.VarChar
  studentEmail                String?   @map("student_email") @db.VarChar
  // Health Information
  height                      Decimal?  @db.Decimal
  weight                      Decimal?  @db.Decimal
  allergies                   String?   @db.Text
  medicalConditions           String?   @map("medical_conditions") @db.Text
  // Emergency Contact
  emergencyContactName        String?   @map("emergency_contact_name") @db.VarChar
  emergencyContactRelationship String?  @map("emergency_contact_relationship") @db.VarChar
  emergencyContactMobile      String?   @map("emergency_contact_mobile") @db.VarChar
  familyDoctorName            String?   @map("family_doctor_name") @db.VarChar
  doctorContactNumber         String?   @map("doctor_contact_number") @db.VarChar
  // Parent Information
  fatherName                  String?   @map("father_name") @db.VarChar
  fatherPhone                 String?   @map("father_phone") @db.VarChar
  fatherEmail                 String?   @map("father_email") @db.VarChar
  fatherOccupation            String?   @map("father_occupation") @db.VarChar
  motherName                  String?   @map("mother_name") @db.VarChar
  motherPhone                 String?   @map("mother_phone") @db.VarChar
  motherEmail                 String?   @map("mother_email") @db.VarChar
  motherOccupation            String?   @map("mother_occupation") @db.VarChar
  guardianName                String?   @map("guardian_name") @db.VarChar
  guardianRelationship        String?   @map("guardian_relationship") @db.VarChar
  guardianContact             String?   @map("guardian_contact") @db.VarChar
  // Extra-curricular
  hobbies                     String?   @db.Text
  interests                   String?   @db.Text
  achievements                String?   @db.Text
  languagesKnown              String?   @map("languages_known") @db.Text
  // Documents
  profilePicture              String?   @map("profile_picture") @db.Text
  birthCertificateUrl         String?   @map("birth_certificate_url") @db.Text
  transferCertificateUrl      String?   @map("transfer_certificate_url") @db.Text
  aadharCardUrl               String?   @map("aadhar_card_url") @db.Text
  idCardUrl                   String?   @map("id_card_url") @db.Text
  reportCardsUrl              String?   @map("report_cards_url") @db.Text
  otherDocumentsUrl           String?   @map("other_documents_url") @db.Text
  // Metadata
  status                      String?   @default("active") @db.VarChar
  profileUpdatedAt            DateTime? @default(now()) @map("profile_updated_at") @db.Timestamptz()
  createdAt                   DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  class                 Class?                  @relation(fields: [classId], references: [classId])
  parent                Parent?                 @relation(fields: [parentId], references: [parentId])
  attendance            Attendance[]
  submissions           Submission[]
  examResults           ExamResult[]
  fees                  Fee[]
  assignmentStudents    AssignmentStudent[]
  aiReportComments      AiReportComment[]
  aiPerformancePredictions AiPerformancePrediction[]
  aiLearningPaths       AiLearningPath[]
  aiStudySessions       AiStudySession[]
  aiHomeworkHelp        AiHomeworkHelp[]
  leaveRequests         LeaveRequest[]
  studentProfileHistory StudentProfileHistory[]

  @@map("students")
}

/// Parents
model Parent {
  parentId     String    @id @default(dbgenerated("gen_random_uuid()")) @map("parent_id") @db.Uuid
  authUserId   String    @map("auth_user_id") @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  fullName     String    @map("full_name") @db.VarChar
  email        String    @db.VarChar
  phone        String?   @db.VarChar
  relation     String?   @db.VarChar
  occupation   String?   @db.VarChar
  status       String?   @default("active") @db.VarChar
  profileImage String?   @map("profile_image") @db.Text
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  school   School    @relation(fields: [schoolId], references: [schoolId])
  children Student[]

  @@map("parents")
}

/// Users (General user reference table)
model User {
  userId     String    @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  authUserId String?   @map("auth_user_id") @db.Uuid
  schoolId   String?   @map("school_id") @db.Uuid
  fullName   String?   @map("full_name") @db.Text
  email      String?   @db.Text
  phone      String?   @db.Text
  role       String?   @db.Text
  status     String?   @default("active") @db.Text
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  school School? @relation(fields: [schoolId], references: [schoolId])

  @@map("users")
}

// ============================================
// ACADEMIC STRUCTURE
// ============================================

/// Subjects
model Subject {
  subjectId   String    @id @default(dbgenerated("gen_random_uuid()")) @map("subject_id") @db.Uuid
  classId     String    @map("class_id") @db.Uuid
  teacherId   String?   @map("teacher_id") @db.Uuid
  subjectName String    @map("subject_name") @db.VarChar
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  class                  Class                   @relation(fields: [classId], references: [classId])
  teacher                Teacher?                @relation(fields: [teacherId], references: [teacherId])
  timetable              Timetable[]
  assignments            Assignment[]
  examTimetable          ExamTimetable[]
  examResults            ExamResult[]
  aiLessonPlans          AiLessonPlan[]
  aiGeneratedAssignments AiGeneratedAssignment[]
  aiReportComments       AiReportComment[]
  aiLearningPaths        AiLearningPath[]
  aiStudySessions        AiStudySession[]
  aiHomeworkHelp         AiHomeworkHelp[]

  @@map("subjects")
}

/// Timetable
model Timetable {
  timetableId String    @id @default(dbgenerated("gen_random_uuid()")) @map("timetable_id") @db.Uuid
  classId     String    @map("class_id") @db.Uuid
  subjectId   String    @map("subject_id") @db.Uuid
  teacherId   String?   @map("teacher_id") @db.Uuid
  dayOfWeek   String    @map("day_of_week") @db.VarChar
  startTime   DateTime  @map("start_time") @db.Time()
  endTime     DateTime  @map("end_time") @db.Time()
  roomNo      String?   @map("room_no") @db.VarChar
  periodType  String?   @default("regular") @map("period_type") @db.VarChar
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  class   Class    @relation(fields: [classId], references: [classId])
  subject Subject  @relation(fields: [subjectId], references: [subjectId])
  teacher Teacher? @relation(fields: [teacherId], references: [teacherId])

  @@map("timetable")
}

/// Period Types
model PeriodType {
  periodTypeId String    @id @default(dbgenerated("gen_random_uuid()")) @map("period_type_id") @db.Uuid
  typeName     String    @map("type_name") @db.Text
  colorCode    String?   @map("color_code") @db.Text
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  @@map("period_types")
}

// ============================================
// ATTENDANCE & ASSIGNMENTS
// ============================================

/// Attendance
model Attendance {
  attendanceId String    @id @default(dbgenerated("gen_random_uuid()")) @map("attendance_id") @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  classId      String    @map("class_id") @db.Uuid
  date         DateTime  @db.Date
  status       String?   @db.VarChar
  markedBy     String?   @map("marked_by") @db.Uuid
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  student  Student  @relation(fields: [studentId], references: [studentId])
  class    Class    @relation(fields: [classId], references: [classId])
  teacher  Teacher? @relation(fields: [markedBy], references: [teacherId])

  @@map("attendance")
}

/// Assignments
model Assignment {
  assignmentId String    @id @default(dbgenerated("gen_random_uuid()")) @map("assignment_id") @db.Uuid
  classId      String    @map("class_id") @db.Uuid
  subjectId    String    @map("subject_id") @db.Uuid
  teacherId    String    @map("teacher_id") @db.Uuid
  title        String    @db.VarChar
  description  String?   @db.Text
  fileUrl      String?   @map("file_url") @db.Text
  dueDate      DateTime? @map("due_date") @db.Date
  maxMarks     Decimal?  @map("max_marks") @db.Decimal
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  class              Class               @relation(fields: [classId], references: [classId])
  subject            Subject             @relation(fields: [subjectId], references: [subjectId])
  teacher            Teacher             @relation(fields: [teacherId], references: [teacherId])
  submissions        Submission[]
  assignmentStudents AssignmentStudent[]

  @@map("assignments")
}

/// Assignment Students (Many-to-Many)
model AssignmentStudent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String    @map("assignment_id") @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [assignmentId])
  student    Student    @relation(fields: [studentId], references: [studentId])

  @@map("assignment_students")
}

/// Submissions
model Submission {
  submissionId   String    @id @default(dbgenerated("gen_random_uuid()")) @map("submission_id") @db.Uuid
  assignmentId   String    @map("assignment_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  submissionText String?   @map("submission_text") @db.Text
  submissionFile String?   @map("submission_file") @db.Text
  submittedAt    DateTime? @default(now()) @map("submitted_at") @db.Timestamptz()
  marksObtained  Decimal?  @map("marks_obtained") @db.Decimal
  feedback       String?   @db.Text
  gradedAt       DateTime? @map("graded_at") @db.Timestamptz()

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [assignmentId])
  student    Student    @relation(fields: [studentId], references: [studentId])

  @@map("submissions")
}

// ============================================
// EXAMINATIONS
// ============================================

/// Exams
model Exam {
  examId    String    @id @default(dbgenerated("gen_random_uuid()")) @map("exam_id") @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  examName  String    @map("exam_name") @db.VarChar
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  school        School          @relation(fields: [schoolId], references: [schoolId])
  class         Class           @relation(fields: [classId], references: [classId])
  examTimetable ExamTimetable[]
  examResults   ExamResult[]
  aiReportComments AiReportComment[]

  @@map("exams")
}

/// Exam Timetable
model ExamTimetable {
  timetableId String    @id @default(dbgenerated("gen_random_uuid()")) @map("timetable_id") @db.Uuid
  examId      String    @map("exam_id") @db.Uuid
  subjectId   String    @map("subject_id") @db.Uuid
  examDate    DateTime  @map("exam_date") @db.Date
  startTime   DateTime  @map("start_time") @db.Time()
  endTime     DateTime  @map("end_time") @db.Time()
  roomNo      String?   @map("room_no") @db.VarChar
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  exam    Exam    @relation(fields: [examId], references: [examId])
  subject Subject @relation(fields: [subjectId], references: [subjectId])

  @@map("exam_timetable")
}

/// Exam Results
model ExamResult {
  resultId      String    @id @default(dbgenerated("gen_random_uuid()")) @map("result_id") @db.Uuid
  examId        String    @map("exam_id") @db.Uuid
  studentId     String    @map("student_id") @db.Uuid
  subjectId     String    @map("subject_id") @db.Uuid
  marksObtained Decimal?  @map("marks_obtained") @db.Decimal
  maxMarks      Decimal?  @map("max_marks") @db.Decimal
  grade         String?   @db.VarChar
  remarks       String?   @db.Text
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  exam    Exam    @relation(fields: [examId], references: [examId])
  student Student @relation(fields: [studentId], references: [studentId])
  subject Subject @relation(fields: [subjectId], references: [subjectId])

  @@map("exam_results")
}

// ============================================
// FINANCE
// ============================================

/// Fees
model Fee {
  feeId       String    @id @default(dbgenerated("gen_random_uuid()")) @map("fee_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  amount      Decimal   @db.Decimal
  status      String?   @default("pending") @db.VarChar
  dueDate     DateTime? @map("due_date") @db.Date
  paymentDate DateTime? @map("payment_date") @db.Date
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  student Student @relation(fields: [studentId], references: [studentId])
  school  School  @relation(fields: [schoolId], references: [schoolId])

  @@map("fees")
}

/// Fee Predictions (AI)
model FeePrediction {
  predictionId       String    @id @default(dbgenerated("gen_random_uuid()")) @map("prediction_id") @db.Uuid
  schoolId           String    @map("school_id") @db.Uuid
  predictionDate     DateTime? @default(dbgenerated("CURRENT_DATE")) @map("prediction_date") @db.Date
  totalExpected      Decimal?  @map("total_expected") @db.Decimal
  totalCollected     Decimal?  @map("total_collected") @db.Decimal
  totalPending       Decimal?  @map("total_pending") @db.Decimal
  predictions        Json?     @db.JsonB
  unusualActivities  Json?     @map("unusual_activities") @db.JsonB
  recommendations    String?   @db.Text
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  school School @relation(fields: [schoolId], references: [schoolId])

  @@map("fee_predictions")
}

/// Payroll
model Payroll {
  payrollId   String    @id @default(dbgenerated("gen_random_uuid()")) @map("payroll_id") @db.Uuid
  teacherId   String    @map("teacher_id") @db.Uuid
  month       String    @db.VarChar
  amount      Decimal   @db.Decimal
  status      String?   @default("pending") @db.VarChar
  paymentDate DateTime? @map("payment_date") @db.Date
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  teacher Teacher @relation(fields: [teacherId], references: [teacherId])

  @@map("payroll")
}

// ============================================
// LIBRARY & OPERATIONS
// ============================================

/// Library Books
model LibraryBook {
  bookId    String    @id @default(dbgenerated("gen_random_uuid()")) @map("book_id") @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  title     String    @db.VarChar
  author    String?   @db.VarChar
  isbn      String?   @db.VarChar
  quantity  Int?      @default(1)
  available Int?      @default(1)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  school School @relation(fields: [schoolId], references: [schoolId])

  @@map("library_books")
}

/// Transport
model Transport {
  transportId String    @id @default(dbgenerated("gen_random_uuid()")) @map("transport_id") @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  routeName   String    @map("route_name") @db.VarChar
  driverName  String?   @map("driver_name") @db.VarChar
  vehicleNo   String?   @map("vehicle_no") @db.VarChar
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  school School @relation(fields: [schoolId], references: [schoolId])

  @@map("transport")
}

/// Inventory
model Inventory {
  itemId       String    @id @default(dbgenerated("gen_random_uuid()")) @map("item_id") @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  itemName     String    @map("item_name") @db.VarChar
  quantity     Int?      @default(0)
  condition    String?   @db.VarChar
  purchaseDate DateTime? @map("purchase_date") @db.Date
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
